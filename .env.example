# Neon — URL poolée (hôte avec "-pooler"), utilisée par l'app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon — URL directe (sans "-pooler"), utilisée par prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Mot de passe unique de l'app
APP_PASSWORD="change-moi"
# Secret de signature des sessions (32+ caractères) : openssl rand -base64 48
SESSION_SECRET=""

# Optionnel : fuseau utilisé pour interpréter les dates (défaut Europe/Paris)
# NEXT_PUBLIC_APP_TIMEZONE="Europe/Paris"
